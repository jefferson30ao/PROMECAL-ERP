{
  "name": "promecal-erp",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @promecal/web",
    "dev:api": "npm run dev --workspace @promecal/api",
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace @promecal/api",
    "build:web": "npm run build --workspace @promecal/web",
    "start": "node apps/api/dist/apps/api/src/main.js",
    "start:api": "node apps/api/dist/apps/api/src/main.js",
    "start:web": "npm run preview --workspace @promecal/web",
    "test": "tsx --test packages/domain/*.test.ts",
    "test:e2e": "playwright test",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.9",
    "prisma": "6.12.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0"
  }
}
